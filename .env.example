# ---------------------------------------------------------------------------
# Helping Station DEU — environment configuration
# Copy to `.env` and fill in. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL 14+) ---------------------------------------------
# Local option A (no install needed, bundled dev server):
#   npm run db:dev      # starts a private Postgres-compatible server on :5433
#   DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/helpingstation"
# Local option B (native install / Docker):
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/helpingstation?schema=public"
# Production: any managed Postgres (Neon, Supabase, RDS, Aiven, Railway...).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/helpingstation"

# --- Auth ------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
AUTH_TRUST_HOST="true"
# Session lifetime in seconds (default 12 hours)
AUTH_MAX_AGE="43200"

# --- Google OAuth (optional) ------------------------------------------------
# Students can sign in with a Google account instead of a password. Both values
# are required; when either is blank the button is hidden automatically.
# Setup: https://console.cloud.google.com/ → APIs & Services → Credentials →
#   Create credentials → OAuth client ID → Application type: Web application
#   Authorized JavaScript origin:  https://your-app.example.com
#   Authorized redirect URI:      https://your-app.example.com/api/auth/callback/google
# Add your app under "APIs & Services → OAuth consent screen" and publish it, or
# add test users, or Google will refuse every request with access_denied.
# Only @deu.ac.kr addresses are accepted; see ALLOWED_EMAIL_DOMAIN in src/auth.ts.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- KakaoTalk OAuth (optional) ---------------------------------------------
# Kakao only needs the REST API key. Set a client secret too if you turned on
# "Use client secret" under Product settings → Kakao Login → Security.
# Setup: https://developers.kakao.com/ → My Application → Product settings →
#   Kakao Login → Redirect URI:
#   https://your-app.example.com/api/auth/callback/kakao
# For the e-mail to be returned, tick "Kakao account email" under
# Kakao Login → Consent items. Without it a student cannot be auto-provisioned.
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""

# --- Application -----------------------------------------------------------
# Public base URL — used for QR codes, printable posters and absolute links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Set to true in production.
APP_IS_PRODUCTION="false"
# Public contact e-mail shown on the rules/privacy pages.
CONTACT_EMAIL="helpingstation@deu.ac.kr"
ORGANIZER_NAME="Helping Station DEU — Dong-Eui University"
DATA_RETENTION_DAYS="180"

# --- Demo mode -------------------------------------------------------------
# Demo mode seeds fictional participants (HS-DEMO-###), never mixes with real
# data, and shows a banner across the app. Turn OFF in production.
DEMO_MODE="true"
SEED_DEMO_DATA="true"
# Credentials created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@helpingstation.deu"
SEED_ADMIN_PASSWORD="ChangeMe!2024"
SEED_STUDENT_EMAIL="student@deu.ac.kr"
SEED_STUDENT_PASSWORD="ChangeMe!2024"

# --- Bot protection (optional) ---------------------------------------------
# When both keys are set, the registration form additionally requires a
# Cloudflare Turnstile token. When unset, the built-in honeypot + timing +
# rate limiting still apply.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Distributed rate limiting (optional) ----------------------------------
# In-memory limiting is used by default (single instance). Set these to share
# counters across instances on Vercel/Render.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Notifications (optional, disabled by default) -------------------------
# Nothing is ever sent automatically. Set to true only after configuring a
# consent-compliant provider and reviewing the retention policy.
NOTIFICATIONS_ENABLED="false"
NOTIFICATION_FROM_EMAIL="no-reply@helpingstation.deu"

# Pooled connections. Use 1 with the bundled PGlite dev server (npm run db:dev).
DB_POOL_MAX="10"
